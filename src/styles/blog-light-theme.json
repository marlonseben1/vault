{
	"name": "blog-light",
	"type": "light",
	"colors": {
		"editor.background": "#ffffff",
		"editor.foreground": "#24292e",
		"editor.selectionBackground": "#0891b233",
		"editorLineNumber.foreground": "#6a737d",
		"editorLineNumber.activeForeground": "#0891b2",
		"editorCursor.foreground": "#24292e",
		"focusBorder": "#0891b2"
	},
	"tokenColors": [
		{
			"settings": { "foreground": "#24292e" }
		},
		{
			"name": "Constants (numbers, links)",
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.other.placeholder",
				"constant.character.format.placeholder",
				"variable.language.this",
				"variable.other.object",
				"variable.other.class",
				"variable.other.constant",
				"meta.property-name",
				"meta.property-value",
				"support",
				"meta.link.inline.markdown"
			],
			"settings": { "foreground": "#005cc5" }
		},
		{
			"name": "Strings",
			"scope": ["string", "markup.fenced_code", "markup.inline"],
			"settings": { "foreground": "#032f62" }
		},
		{
			"name": "Comments",
			"scope": ["comment", "string.quoted.docstring.multi"],
			"settings": { "foreground": "#6a737d", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage.modifier",
				"storage.type",
				"storage.control.clojure",
				"entity.name.function.clojure",
				"entity.name.tag.yaml",
				"support.function.node",
				"support.type.property-name.json",
				"punctuation.separator.key-value",
				"punctuation.definition.template-expression"
			],
			"settings": { "foreground": "#d73a49" }
		},
		{
			"name": "Parameters",
			"scope": "variable.parameter.function",
			"settings": { "foreground": "#24292e" }
		},
		{
			"name": "Functions, Types",
			"scope": [
				"support.function",
				"entity.name.type",
				"entity.other.inherited-class",
				"meta.function-call",
				"meta.instance.constructor",
				"entity.other.attribute-name",
				"entity.name.function",
				"constant.keyword.clojure"
			],
			"settings": { "foreground": "#24292e" }
		},
		{
			"name": "Tags (JSX/HTML), quoted/template strings",
			"scope": [
				"entity.name.tag",
				"string.quoted",
				"string.regexp",
				"string.interpolated",
				"string.template",
				"string.unquoted.plain.out.yaml",
				"keyword.other.template"
			],
			"settings": { "foreground": "#22863a" }
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation.definition.arguments",
				"punctuation.definition.dict",
				"punctuation.separator",
				"meta.function-call.arguments"
			],
			"settings": { "foreground": "#24292e" }
		},
		{
			"name": "Markdown links",
			"scope": ["markup.underline.link", "punctuation.definition.metadata.markdown"],
			"settings": { "foreground": "#24292e" }
		},
		{
			"name": "Markdown list",
			"scope": ["beginning.punctuation.definition.list.markdown"],
			"settings": { "foreground": "#032f62" }
		},
		{
			"name": "Markdown punctuation brackets",
			"scope": [
				"punctuation.definition.string.begin.markdown",
				"punctuation.definition.string.end.markdown",
				"string.other.link.title.markdown",
				"string.other.link.description.markdown"
			],
			"settings": { "foreground": "#d73a49" }
		}
	]
}
